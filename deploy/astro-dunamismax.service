[Unit]
Description=dunamismax.com Astro website
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=astro-dunamismax-web
Group=astro-dunamismax-web
WorkingDirectory=/srv/www/dunamismax.com/current
Environment=NODE_ENV=production APP_ENV=production APP_URL=https://dunamismax.com HOST=127.0.0.1 PORT=4311
EnvironmentFile=/etc/astro-apps/dunamismax/web.env
ExecStart=/opt/astro-runtime/bin/node /srv/www/dunamismax.com/current/dist/cli/bin/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
StateDirectory=astro-dunamismax
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
