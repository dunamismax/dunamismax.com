---
import Layout from '../../layouts/Layout.astro';
import Error from '../../components/Error.astro';
import { posts } from '../../lib/posts.js';
import type { Post } from '../../lib/posts.js';
import { shortDate, readingMinutes } from '../../lib/text.js';
const raw = Astro.url.searchParams.get('page') ?? '1';
const page = Number(raw);
let code = /^(?:[1-9][0-9]*)$/.test(raw) && page <= 100000 ? 200 : 404;
let pages = 1;
let items: Post[] = [];
if (code === 200) { try { pages = Math.max(1, Math.ceil(await posts.count() / 10)); if (page > pages) code = 404; else items = await posts.latest(10, (page - 1) * 10); } catch { code = 503; console.error('Blog database unavailable'); } }
Astro.response.status = code;
const title = code === 200 ? 'Blog' : code === 503 ? 'Temporarily unavailable' : 'Not found';
---
<Layout title={title} description="Build logs, design notes, and server notes from Stephen Sawyer." path={'/blog' + (page > 1 ? '?page=' + page : '')} status={code}>
{code !== 200 ? <Error code={code} /> : <>
<section class="page-hero" aria-labelledby="blog-title"><div class="section-inner"><p class="eyebrow">Blog</p><h1 id="blog-title">Notes from shipping software.</h1><p class="lede">Build logs, design notes, and server notes from Astro and TypeScript web work, Python scripting, and self-hosted operations.</p></div></section>
<section class="page-section"><div class="section-inner">
{items.length === 0 ? <section class="empty-state" aria-labelledby="empty-title"><p class="eyebrow">No posts yet.</p><h2 id="empty-title">The blog route is ready.</h2><p>Published posts will render here and in the RSS feed. Drafts stay private until they are published.</p><a href="/projects" class="section-link">Browse current projects</a></section> : <ul class="card-list">{items.map(item => <li><a href={'/blog/' + item.slug} class="post-card"><span class="post-card__meta"><time datetime={item.published_at.toISOString().slice(0,10)}>{shortDate(item.published_at)}</time> · {readingMinutes(item.body)} min read</span><span class="post-card__title">{item.title}</span>{item.excerpt && <span class="post-card__description">{item.excerpt}</span>}</a></li>)}</ul>}
{pages > 1 && <nav class="pagination" aria-label="Blog pages">{page > 1 && <a href={'/blog' + (page > 2 ? '?page=' + (page - 1) : '')} class="section-link">Newer posts</a>}<span>Page {page} of {pages}</span>{page < pages && <a href={'/blog?page=' + (page + 1)} class="section-link">Older posts</a>}</nav>}
</div></section></>}
</Layout>
