# Copy to .env. Plain KEY=value; optional matching quotes, no interpolation.
# Process environment variables take precedence. Never commit credentials.
APP_ENV=local
APP_URL=http://localhost:8000

# Leave DB_NAME blank for a local preview without MySQL.
# Production requires a configured, reachable MySQL database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=dunamismax_web
DB_PASSWORD=
