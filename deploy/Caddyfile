# Installed as /etc/caddy/sites/dunamismax.com.caddy by 04-cutover.sh, which
# also removes the old inline blocks from /etc/caddy/Caddyfile.
www.dunamismax.com {
	redir https://dunamismax.com{uri} permanent
}

dunamismax.com {
	root * /srv/www/dunamismax.com/current/public
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "0"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Exactly two files are served directly. Every other path goes to PHP,
	# which answers unknown and private paths (including dotfiles) with 404.
	@stylesheet path /css/site.css
	handle @stylesheet {
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	@icon path /icon.svg
	handle @icon {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		rewrite * /index.php
		php_fastcgi unix//run/php/dunamismax.sock
	}

	log {
		output file /var/log/caddy/dunamismax-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
	}
}
